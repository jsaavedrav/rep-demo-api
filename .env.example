# Copia este archivo a .env y completa los valores. .env NO se sube al repo.

PORT=3000

# --- Base de datos: usa UNA de las dos opciones ---

# Opción A: cadena de conexión (desarrollo local con Docker, o usuario SQL en Azure)
SQL_CONNECTION_STRING=Server=localhost,1433;Database=repdb;User ID=sa;Password=<tu-contraseña>;Encrypt=True;TrustServerCertificate=True;Connection Timeout=60

# Opción B: Managed Identity en Azure (sin contraseña). Deja SQL_CONNECTION_STRING vacío.
# SQL_SERVER=<tu-servidor>.database.windows.net
# SQL_DATABASE=repdb
# AZURE_CLIENT_ID=<solo si usas una identidad asignada por el usuario>

# --- Solo desarrollo local ---
# Simula el usuario autenticado cuando no hay Static Web Apps delante.
# Se ignora si NODE_ENV=production.
DEV_USER_EMAIL=admin@demo.cl

# --- docker compose ---
# Contraseña del usuario sa del SQL Server local (mín. 8 caracteres, mayúsculas, minúsculas, números y símbolos).
MSSQL_SA_PASSWORD=
